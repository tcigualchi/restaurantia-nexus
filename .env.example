# RestaurantIA Nexus — environment variables.
# Copy to .env for docker compose (all values below have safe LOCAL defaults).
# Never commit a real .env. Generate secrets with:  openssl rand -base64 48

# --- Runtime -----------------------------------------------------------------
APP_ENV=development            # development | test | production (Vercel: production by default in Production)
LOG_LEVEL=INFO
# server: a worker process advances simulations, events and agents (Docker, local).
# serverless: no worker; dashboard polls to /live do that work (detected automatically on Vercel).
RUNTIME_MODE=server
# Per-session statement timeout on direct connections. Skipped automatically behind a transaction-mode
# pooler (Neon "-pooler" hosts are detected; force with DB_POOLED=true|false).
DB_STATEMENT_TIMEOUT_MS=15000

# --- Database (docker compose builds DATABASE_URL from these) ----------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus        # local only; use a managed DB secret in production
POSTGRES_DB=nexus
# Outside docker compose set the full URL instead (postgres:// URLs are normalised):
# DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# --- Auth ----------------------------------------------------------------------
# Required in production (>= 32 random chars). Empty in development => ephemeral secret.
JWT_SECRET=
JWT_TTL_MINUTES=120

# --- Web BFF <-> API -------------------------------------------------------------
# Browser origins allowed to call the API directly (the web app uses a same-origin BFF proxy).
CORS_ORIGINS=http://localhost:3000
# Shared secret so the API trusts the client IP forwarded by the web BFF (rate limits/quotas).
# Set the same value in the API and web services, and TRUST_PROXY_HEADERS=true on the API
# (implied in serverless mode, where the API is only reachable through the BFF).
PROXY_SHARED_SECRET=
TRUST_PROXY_HEADERS=false
# Web only: where the BFF reaches the API (server-side, never exposed to the browser).
# On Vercel the service binding injects it; do not set it there.
API_INTERNAL_URL=http://localhost:8000

# --- Demo sandbox ----------------------------------------------------------------
DEMO_ENABLED=true
DEMO_SESSION_TTL_MINUTES=120
DEMO_MAX_SESSIONS_PER_IP_PER_HOUR=5
DEMO_MAX_ACTIVE_SESSIONS=200

# --- Agents / LLM ----------------------------------------------------------------
# deterministic = no LLM (scripted tool plans + template summaries, clearly labelled in the UI)
# openai_compatible = any /chat/completions server with tool calling (hosted API, gateway, Ollama, vLLM)
LLM_PROVIDER=deterministic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional: prices you verified for your provider (USD per 1M tokens). Cost shows N/A when unset.
LLM_PRICE_INPUT_PER_MTOK_USD=
LLM_PRICE_OUTPUT_PER_MTOK_USD=
# memory | postgres  (LangGraph checkpoints)
AGENT_CHECKPOINTER=memory

# --- Optional local admin created by `nexus-seed` (no default credentials exist) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Vercel (see docs/deploy.md) ------------------------------------------------
# Set in the Vercel project (Production + Preview): JWT_SECRET and PROXY_SHARED_SECRET.
# The Neon integration injects DATABASE_URL (pooled, runtime) and DATABASE_URL_UNPOOLED (direct, migrations).
